{
    "name": "jaul",
    "version": "2.0.0",
    "description": "Just another utilities library. But a good one.",
    "keywords": [
        "jaul",
        "utils",
        "utilities",
        "network",
        "io",
        "system"
    ],
    "author": "Igor Ramadas <igor@ramadas.net>",
    "subdomain": "jaul",
    "license": "MIT",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/esm.d.mts",
                "default": "./lib/esm.mjs"
            },
            "require": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        },
        "./lib/*.js": "./lib/*.js",
        "./lib/*.d.ts": "./lib/*.d.ts",
        "./lib/*": "./lib/*.js",
        "./package.json": "./package.json"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/igoramadas/jaul.git"
    },
    "engines": {
        "node": ">= 22.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig-build.json",
        "build-test": "tsc -p tsconfig-test.json",
        "clean": "rm -rf ./lib && rm -rf ./lib-test && rm -rf ./coverage",
        "prebuild": "npm run clean",
        "test": "npm run build && npm run build-test && mocha ./test/*.ts && node ./test/test-esm.mjs",
        "test-coverage": "nyc --reporter=lcov npm test"
    },
    "devDependencies": {
        "@istanbuljs/nyc-config-typescript": "^1.0.2",
        "@types/node": "^26.6.4",
        "chai": "^4.5.0",
        "coveralls": "^3.1.1",
        "express": "^5.2.1",
        "get-port": "<6.0.0",
        "mocha": "^12.0.3",
        "mocha-lcov-reporter": "^1.3.0",
        "nyc": "^18.0.0",
        "socket.io-client": "^4.8.4",
        "source-map-support": "^0.5.21",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": false,
        "arrowParens": "always",
        "bracketSpacing": false,
        "printWidth": 250
    },
    "mocha": {
        "timeout": 4000,
        "exit": true,
        "recursive": true,
        "require": [
            "test/mocha.env",
            "tsx/cjs",
            "source-map-support/register"
        ]
    },
    "nyc": {
        "extends": "@istanbuljs/nyc-config-typescript",
        "temp-dir": "./coverage",
        "reporter": [
            "lcov",
            "text"
        ]
    }
}
